# Copy to .env.local. Never commit credentials.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Copy SUPABASE_URL above here; this key is public and used only for Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-6-luna
# Speaker separation requires a model supporting diarized_json.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# Default local. Set protected ONLY after enabling hosting access protection
# for every deployed URL, including the production domain. This is an operator
# acknowledgement, not an authentication mechanism.
DEMO_ACCESS_MODE=local
